# Required: Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Recommended: canonical public origin; use http://localhost:3000 locally and your custom HTTPS domain in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: only needed for privileged server-side invite lookups
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
