# Required: Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Public origins. Use separate hostnames so the central auth cookie remains isolated.
NEXT_PUBLIC_SITE_URL=http://smartrain.localhost:3000
NEXT_PUBLIC_AUTH_URL=http://auth.localhost:3000

# Supabase Authentication > OAuth Apps > Smartrain (confidential client)
SUPABASE_OAUTH_CLIENT_ID=your-smartrain-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-smartrain-oauth-client-secret

# Comma-separated exact hosts or suffixes beginning with a dot
SSO_ALLOWED_HOSTS=.etienneschwab.ch,.localhost,localhost,127.0.0.1

# Optional: only needed for privileged server-side invite lookups
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
